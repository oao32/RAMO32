# ==============================================================================
# OAO - OWN AURA OUTCOME Training Portal
# Environment Variables Configuration Guide
# ==============================================================================
#
# 1. Supabase Cloud Database Configuration (Optional / اختياري)
# The application is 100% functional locally via LocalStorage without Supabase.
# To enable multi-device cloud synchronization, create a project at https://supabase.com
# and copy your project URL and public anon key below:
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key-here

# 2. Server-Side AI Assistant (Optional)
# For server-side Gemini workout and nutrition AI plan generation
GEMINI_API_KEY=
