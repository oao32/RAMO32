# ==============================================================================
# OAO - OWN AURA OUTCOME Training Portal
# Environment Variables Configuration Guide
# ==============================================================================
#
# 1. Supabase Cloud Database Configuration
# Copy your project URL and public anon key from Supabase Dashboard -> Project Settings -> API:
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key-here

# Optional Server-Side Admin Key (Never expose to client or prefix with VITE_)
# Allows server.ts admin routes to bypass RLS when adding/managing subscribers:
SUPABASE_SERVICE_ROLE_KEY=

# 2. Server-Side AI Assistant (Optional)
# For server-side Gemini workout and nutrition AI plan generation
GEMINI_API_KEY=
